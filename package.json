{
  "name": "popcorn-loop",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "build": "nx run-many --target=build --all"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "nx": "22.1.3",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}