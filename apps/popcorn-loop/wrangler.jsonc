{
	"main": "dist/_worker.js/index.js",
	"name": "popcorn-loop",
  "compatibility_date": "2025-12-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
	"durable_objects": {
		"bindings": [
			{
				"name": "COLLABORATIVE_ROOM",
				"class_name": "CollaborativeRoom",
				"script_name": "popcorn-loop"
			}
		]
	}
}