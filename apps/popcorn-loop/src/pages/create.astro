---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Create Session - Popcorn Loop</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #000000 0%, #1a0033 50%, #000033 100%);
        color: #fff;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      
      .container {
        max-width: 600px;
        width: 100%;
      }
      
      .card {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      }
      
      h1 {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #FF0080, #00D9FF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
      }
      
      .subtitle {
        color: #999;
        margin-bottom: 2rem;
      }
      
      .form-group {
        margin-bottom: 1.5rem;
      }
      
      label {
        display: block;
        color: #00D9FF;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }
      
      input, select {
        width: 100%;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      select > option {
        background: #111;
        color: #fff;
        font-size: 1rem;
      }
      
      input:focus, select:focus {
        outline: none;
        border-color: #00D9FF;
        box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.1);
      }
      
      .btn {
        width: 100%;
        padding: 1.25rem;
        font-size: 1.2rem;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
      }
      
      .btn-primary {
        background: linear-gradient(135deg, #FF0080, #00D9FF);
        color: white;
      }
      
      .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 30px rgba(255, 0, 128, 0.6);
      }
      
      .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      
      .btn-secondary {
        background: transparent;
        color: #999;
        border: 1px solid rgba(255, 255, 255, 0.2);
        margin-top: 0.5rem;
      }
      
      .btn-secondary:hover {
        border-color: #00D9FF;
        color: #00D9FF;
      }
      
      .loading {
        text-align: center;
        color: #00D9FF;
        margin-top: 1rem;
        display: none;
      }
      
      .error {
        background: rgba(255, 0, 0, 0.1);
        border: 1px solid rgba(255, 0, 0, 0.3);
        color: #ff6b6b;
        padding: 1rem;
        border-radius: 8px;
        margin-top: 1rem;
        display: none;
      }
      
      .info-box {
        background: rgba(0, 217, 255, 0.1);
        border: 1px solid rgba(0, 217, 255, 0.3);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
      }
      
      .info-box p {
        color: #aaa;
        font-size: 0.9rem;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h1>Create Session</h1>
        <p class="subtitle">Start a new collaborative loop session</p>
        
        <div class="info-box">
          <p>
            <strong>🎵 How it works:</strong><br>
            Create a room where 2-4 people can collaborate on audio-visual loops.
            You'll get a shareable room code to invite others.
          </p>
        </div>
        
        <form id="createForm">
          <div class="form-group">
            <label for="userName">Your Name</label>
            <input 
              type="text" 
              id="userName" 
              name="userName" 
              placeholder="Enter your name"
              required
              maxlength="50"
            />
          </div>
          
          <div class="form-group">
            <label for="bpm">BPM (Tempo)</label>
            <select id="bpm" name="bpm">
              <option value="90">90 BPM - Slow & Chill</option>
              <option value="100">100 BPM - Laid Back</option>
              <option value="110">110 BPM - Groove</option>
              <option value="120" selected>120 BPM - Standard</option>
              <option value="130">130 BPM - Energetic</option>
              <option value="140">140 BPM - Fast</option>
            </select>
          </div>
          
          <div class="form-group">
            <label for="loopLength">Loop Length</label>
            <select id="loopLength" name="loopLength">
              <option value="4" selected>4 bars (~8 seconds at 120 BPM)</option>
              <option value="8">8 bars (~16 seconds at 120 BPM)</option>
              <option value="16">16 bars (~32 seconds at 120 BPM)</option>
            </select>
          </div>
          
          <div class="form-group">
              <button type="submit" class="btn btn-primary" id="createBtn">
                Create Session
              </button>
          </div>
          
          <div class="form-group" style="text-align: center;padding-top: 1rem;">
              <a href="/" class="btn btn-secondary">
                ← Back to Home
              </a>
          </div>
        </form>
        
        <div class="loading" id="loading">
          Creating your session...
        </div>
        
        <div class="error" id="error"></div>
      </div>
    </div>

    <script>
      import { generateUserId } from '@workspace/shared-utils';
      
      const form = document.getElementById('createForm') as HTMLFormElement;
      const createBtn = document.getElementById('createBtn') as HTMLButtonElement;
      const loading = document.getElementById('loading') as HTMLDivElement;
      const errorDiv = document.getElementById('error') as HTMLDivElement;
      
      const userId = generateUserId();
      
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const userName = formData.get('userName') as string;
        const bpm = parseInt(formData.get('bpm') as string);
        const loopLength = parseInt(formData.get('loopLength') as string);
        
        if (!userName.trim()) {
          showError('Please enter your name');
          return;
        }
        
        createBtn.disabled = true;
        loading.style.display = 'block';
        errorDiv.style.display = 'none';
        
        try {
          const response = await fetch('/api/sessions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              userId,
              userName: userName.trim(),
            }),
          });
          
          if (!response.ok) {
            throw new Error('Failed to create session');
          }
          
          const data = await response.json();
          
          // Redirect to the room
          window.location.href = `/room/${data.roomId}?userId=${userId}&userName=${encodeURIComponent(userName)}`;
          
        } catch (error) {
          console.error('Error creating session:', error);
          showError('Failed to create session. Please try again.');
          createBtn.disabled = false;
          loading.style.display = 'none';
        }
      });
      
      function showError(message: string) {
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
      }
    </script>
  </body>
</html>
