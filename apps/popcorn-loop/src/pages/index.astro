---
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/Header.astro";

const features = [
  {
	icon: "🎵",
	title: "Live Audio Synthesis",
	description: "Create loops with Tone.js powered synthesis. Hardware-accurate timing ensures perfect synchronization."
  },
  {
	icon: "🎨",
	title: "Generative Visuals",
	description: "P5.js sketches react to your audio in real-time. Choose from particles, waves, geometry, and more."
  },
  {
	icon: "👥",
	title: "2-4 Person Collab",
	description: "Take turns creating loops in a shared session. Server-authoritative state keeps everyone in sync."
  },
  {
	icon: "🔄",
	title: "Undo/Redo",
	description: "Command pattern history lets you experiment freely. Roll back changes or redo your favorite ideas."
  },
  {
	icon: "⚡",
	title: "Real-time Sync",
	description: "WebSocket collaboration via Cloudflare Durable Objects. Low latency, high reliability."
  },
  {
	icon: "🎯",
	title: "Turn-based Play",
	description: "Structured creativity with turn management. Everyone gets their moment to add to the composition."
  }
];
---
<BaseLayout>
	<div class="container">
      <!-- 
	  <section class="features">
        <div class="feature-card">
          <span class="feature-icon">🎵</span>
          <h3>Live Audio Synthesis</h3>
          <p>Create loops with Tone.js powered synthesis. Hardware-accurate timing ensures perfect synchronization.</p>
        </div>
      </section> 
	  -->

	  	<section class="bg-transparent dark:bg-gray-900">
			<div class="cta-buttons">
				<a href="/create" class="btn btn-primary">Create Session</a>
				<a href="/join" class="btn btn-secondary">Join Session</a>
			</div>
			<div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
				<!-- <div class="mx-auto max-w-screen-md text-center mb-8 lg:mb-16">
					<h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">Secure platform, secure data</h2>
					<p class="font-light text-gray-500 dark:text-gray-400 sm:text-xl">Here at Flowbite we focus on markets where technology, innovation, and capital can unlock long-term value and drive economic growth.</p>
				</div> -->
				<div class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 md:gap-8 xl:gap-8 md:space-y-0">
					{ features.map(feature => (
						<div class="p-6 bg-black rounded shadow dark:bg-gray-800 flex flex-col items-center">
							<div class="flex justify-center items-center mb-4 w-10 h-10 rounded bg-primary-100 lg:h-12 lg:w-12 dark:bg-primary-900">
								<span class="text-4xl">{feature.icon}</span>
							</div>
							<h3 class="mb-2 text-xl font-bold dark:text-white">{feature.title}</h3>
							<p class="font-light text-gray-500 dark:text-gray-400">{feature.description}</p>
						</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="demo-section">
			<h2>How It Works</h2>
			<p style="color: #aaa; font-size: 1.2rem; max-width: 800px; margin: 0 auto;">
			Create a session, invite up to 3 friends, and take turns crafting 4-16 second musical loops. 
			Each loop can trigger synchronized visual effects. The master clock ensures frame-perfect audio-visual alignment.
			</p>
			
			<div class="stats">
			<div class="stat">
				<div class="stat-number">4-16s</div>
				<div class="stat-label">Loop Length</div>
			</div>
			<div class="stat">
				<div class="stat-number">2-4</div>
				<div class="stat-label">Collaborators</div>
			</div>
			<div class="stat">
				<div class="stat-number">&lt;50ms</div>
				<div class="stat-label">Audio Latency</div>
			</div>
			<div class="stat">
				<div class="stat-number">60fps</div>
				<div class="stat-label">Visual Rate</div>
			</div>
			</div>
		</section>
    </div>
</BaseLayout>